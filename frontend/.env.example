# Copy to .env.local for local builds. In GitHub Actions these come from
# repository *Variables* (not Secrets — none of these values are secret).
# Never put secrets in VITE_* variables: they are embedded in the public bundle.

# "api" (default) talks to the backend. "mock" uses local demo data and is
# only honoured by the Vite dev server (npm run dev:mock).
VITE_DATA_MODE=api

# Public base path. "/" locally, "/<repo-name>/" for GitHub Pages project sites.
VITE_BASE_PATH=/

# Apps Script web app URL (Deploy → Web app → URL ending in /exec).
VITE_API_BASE_URL=

# Google OAuth 2.0 Web client ID (…apps.googleusercontent.com). Public identifier.
VITE_GOOGLE_CLIENT_ID=

# OneSignal App ID (UUID). Public identifier. The REST API key is NOT used here;
# it lives only in Apps Script Script Properties.
VITE_ONESIGNAL_APP_ID=
